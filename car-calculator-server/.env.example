# MongoDB 连接字符串
# 格式: mongodb://用户名:密码@主机:端口/数据库名?authSource=admin
MONGODB_URI=mongodb://username:password@xxx.mongodb.rds.aliyuncs.com:3717/carCalculator?authSource=admin

# JWT 密钥（用于生成和验证 Token）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 服务器端口（本地开发使用，阿里云函数计算会忽略）
PORT=3000

# 环境
NODE_ENV=production
